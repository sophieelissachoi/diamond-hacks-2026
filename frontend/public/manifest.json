{
	"manifest_version": 3,
	"name": "Mise",
	"version": "1.0",
	"description": "blah",
	"action": {
		"default_popup": "index.html"
	},
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"permissions": ["storage", "tabs", "camera", "scripting"],
	"host_permissions": ["http://localhost:3001/*", "<all_urls>"]
}
